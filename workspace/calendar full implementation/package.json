{
  "name": "calendly-2026",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run frontend\"",
    "frontend": "vite --config=frontend/vite.config.js",
    "server": "cross-env NODE_ENV=development nodemon backend/server.js",
    "build": "vite build && cp -r frontend/public/* backend/dist/public",
    "postbuild": "node backend/prepareStatic.js",
    "start": "node backend/server.js"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "cross-env": "^7.0.3",
    "express": "^4.18.2",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "vite": "^5.3.3",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.19"
  }
}